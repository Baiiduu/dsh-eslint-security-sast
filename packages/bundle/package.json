{
  "name": "@aaub-software/dsh-eslint-security-sast",
  "version": "0.1.0",
  "description": "ESLint Security SAST bundle and model-facing scan tool for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baiiduu/dsh-eslint-security-sast.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/Baiiduu/dsh-eslint-security-sast#readme",
  "bugs": {
    "url": "https://github.com/Baiiduu/dsh-eslint-security-sast/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "eslint",
    "sast",
    "security",
    "typescript"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.10.0",
    "eslint-plugin-security": "4.0.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-rc.1",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/node": "^24.0.0"
  }
}
